--- /dev/null
+++ b/packages/client/web/src/mobile.css
@@ -0,0 +1,30 @@
+/* Mobile adaptation — conservative, additive rules for small screens.
+ * Component-level responsive layout (collapsible panes, drawers) lives in the
+ * owning plugin packages; this sheet only fixes hard mobile-breaking issues:
+ * viewport overflow, iOS input auto-zoom, notched-device safe areas, and tap
+ * latency on coarse pointers. Safe-area env() values are 0 on non-notched
+ * devices and on desktop, so these rules are inert there. */
+@media (max-width: 767px) {
+  html, body {
+    overflow-x: hidden;
+  }
+
+  /* iOS zooms into any input whose font-size is below 16px on focus; keep
+     the page steady while typing on a phone. */
+  input, textarea, select {
+    font-size: 16px;
+  }
+
+  /* Notched / gesture-bar phones: keep content clear of the home indicator
+     and screen edges (viewport-fit=cover must be set in the viewport meta). */
+  body {
+    padding-bottom: env(safe-area-inset-bottom, 0px);
+  }
+}
+
+/* Coarse pointers (touch) get instant tap response everywhere. */
+@media (pointer: coarse) {
+  button, a, [role='button'] {
+    touch-action: manipulation;
+  }
+}
