index 0000000000..a5b18d18ab
--- /dev/null
+++ b/apps/web/public/sw.js
@@ -0,0 +1,67 @@
+/* DeepSeek Harness Service Worker
+ *
+ * Enables true PWA installability (Chrome requires a fetch-handling SW) and
+ * gives the shell a resilient static cache: hashed /assets are cache-first,
+ * navigations are network-first with a cached index.html fallback. RPC
+ * (/api) and the event stream are NEVER cached — this is a remote-control
+ * client, freshness of the live session always wins.
+ *
+ * Served from the dist root (apps/web/public/sw.js). Scope '/' — the SPA.
+ * Bump CACHE on every deploy of changed shell assets.
+ */
+const CACHE = 'dsh-shell-v1'
+const CACHEABLE = /^\/assets\//
+const NON_CACHEABLE = /^\/api\//
+
+self.addEventListener('install', (event) => {
+  self.skipWaiting()
+  // Best-effort precache of the SPA shell; never fail install on network hiccups.
+  event.waitUntil(
+    caches.open(CACHE).then((cache) => cache.addAll(['/'])).catch(() => {}),
+  )
+})
+
+self.addEventListener('activate', (event) => {
+  event.waitUntil((async () => {
+    const keys = await caches.keys()
+    await Promise.all(keys.filter((key) => key !== CACHE).map((key) => caches.delete(key)))
+    await self.clients.claim()
+  })())
+})
+
+self.addEventListener('fetch', (event) => {
+  const { request } = event
+  if (request.method !== 'GET') return
+  const url = new URL(request.url)
+  if (url.origin !== self.location.origin) return
+  if (NON_CACHEABLE.test(url.pathname)) return
+
+  if (request.mode === 'navigate') {
+    // Network-first: always prefer the live app; fall back to the cached shell.
+    event.respondWith((async () => {
+      try {
+        const fresh = await fetch(request)
+        const cache = await caches.open(CACHE)
+        cache.put('/index.html', fresh.clone())
+        return fresh
+      } catch {
+        const cached = (await caches.match('/index.html')) ?? (await caches.match('/'))
+        return cached ?? Response.error()
+      }
+    })())
+    return
+  }
+
+  // Hashed assets are immutable: cache-first. Other same-origin GETs pass through.
+  if (!CACHEABLE.test(url.pathname)) return
+  event.respondWith((async () => {
+    const cached = await caches.match(request)
+    if (cached) return cached
+    const fresh = await fetch(request)
+    if (fresh.ok) {
+      const cache = await caches.open(CACHE)
+      cache.put(request, fresh.clone())
+    }
+    return fresh
+  })())
+})
