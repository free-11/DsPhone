 if (el === null) throw new Error('web app: missing #root')
 void new AppWebEntry(el).run()
+
+// PWA: register the service worker (HTTPS only — Tailscale Serve / any TLS
+// gateway provides a secure context). Enables install-to-home-screen and a
+// resilient cached shell. Registration failure is non-fatal.
+if (window.isSecureContext && 'serviceWorker' in navigator) {
+  void navigator.serviceWorker.register('/sw.js').catch((reason) => {
+    console.warn('service worker registration failed', reason)
+  })
+}
